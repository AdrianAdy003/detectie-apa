---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localBusinessJsonLd } from '../lib/jsonld';
import { WHATSAPP_URL, SERVICE_AREAS, MAX_DEPTH_METERS, SERVICE_PRICE_LEI } from '../config';
import GroundLayers from '../components/illustrations/GroundLayers.astro';
import Testimonials from '../components/Testimonials.astro';
import { getCollection } from 'astro:content';

const title = 'Detecție apă subterană fără foraj';
const description =
  'Localizăm sursele de apă subterană printr-o metodă geoelectrică non-invazivă, fără foraj de probă. Servicii profesioniste pentru fântâni și puțuri.';

const recentPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title={title} description={description} path="/" jsonLd={localBusinessJsonLd()}>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <h1>Găsim apa subterană înainte să sapi</h1>
        <p>
          Folosim o metodă geoelectrică non-invazivă, bazată pe măsurarea rezistivității electrice
          a subsolului, pentru a estima locul, adâncimea și potențialul unei surse de apă —
          fără forare de probă și fără să afectăm terenul.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/contact/">Solicită o ofertă</a>
          <a class="btn btn-whatsapp" href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer">
            Scrie-ne pe WhatsApp
          </a>
        </div>
        <ul class="hero-trust-bar">
          <li>Fără foraj de probă</li>
          <li>De la {SERVICE_PRICE_LEI} lei / detecție</li>
          <li>Până la {MAX_DEPTH_METERS} m adâncime</li>
          <li>{SERVICE_AREAS.join(', ')}</li>
        </ul>
      </div>
      <GroundLayers />
    </div>
  </section>

  <section class="container">
    <h2>Ce facem</h2>
    <div class="card-grid">
      <div class="card">
        <h3>Detecție geoelectrică</h3>
        <p>
          Măsurăm variațiile de rezistivitate electrică a solului pentru a identifica zonele cu
          probabilitate ridicată de a conține apă subterană.
        </p>
      </div>
      <div class="card">
        <h3>Estimare adâncime</h3>
        <p>
          Oferim o estimare orientativă a adâncimii la care se află stratul acvifer, utilă pentru
          planificarea forajului.
        </p>
      </div>
      <div class="card">
        <h3>Raport clar</h3>
        <p>
          Primești un raport cu punctul recomandat, adâncimea estimată și observațiile din teren,
          fără termeni tehnici inutili.
        </p>
      </div>
    </div>
  </section>

  <section class="container">
    <h2>De ce să ne alegi</h2>
    <div class="card-grid">
      <div class="card">
        <h3>Transparență</h3>
        <p>
          Îți explicăm clar ce arată măsurătorile și care e gradul de încredere al recomandării —
          fără promisiuni pe care metoda nu le poate susține.
        </p>
      </div>
      <div class="card">
        <h3>Fără foraj de probă</h3>
        <p>
          Evaluarea nu presupune nicio intervenție asupra terenului — doar măsurători la
          suprafață, fără urme și fără costuri ascunse.
        </p>
      </div>
      <div class="card">
        <h3>Acoperire până la {MAX_DEPTH_METERS} m</h3>
        <p>
          Putem detecta prezența apei subterane la adâncimi de până la aproximativ {MAX_DEPTH_METERS} m,
          acoperind marea majoritate a situațiilor întâlnite în teren.
        </p>
      </div>
    </div>
  </section>

  <section class="container">
    <h2>De ce să alegi o evaluare înainte de foraj</h2>
    <p class="prose">
      Un foraj executat "la noroc" poate însemna cheltuieli suplimentare dacă nu se găsește apă
      la adâncimea sau în cantitatea dorită. O evaluare prealabilă reduce acest risc și te ajută
      să iei o decizie informată, pe baza unor măsurători, nu a presupunerilor.
    </p>
  </section>

  <Testimonials />

  <section class="container">
    <h2>Zone deservite</h2>
    <p>{SERVICE_AREAS.join(', ')}. Pentru alte zone, ne poți contacta — verificăm disponibilitatea.</p>
    <a class="btn btn-outline" href="/zone-acoperite/">Vezi zonele acoperite</a>
  </section>

  {recentPosts.length > 0 && (
    <section class="container">
      <h2>Din blog</h2>
      <div class="card-grid">
        {recentPosts.map((post) => (
          <a class="card post-card" href={`/blog/${post.id}/`}>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
          </a>
        ))}
      </div>
      <a class="btn btn-outline" href="/blog/">Vezi toate articolele</a>
    </section>
  )}
</BaseLayout>
