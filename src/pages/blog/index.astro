---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { breadcrumbListJsonLd } from '../../lib/jsonld';

const title = 'Blog';
const description = 'Articole despre detecția apei subterane, foraj și evaluarea terenului.';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const jsonLd = breadcrumbListJsonLd([
  { name: 'Acasă', path: '/' },
  { name: 'Blog', path: '/blog/' },
]);
---

<BaseLayout title={title} description={description} path="/blog/" jsonLd={jsonLd}>
  <section class="page-header container">
    <h1>Blog</h1>
    <p>Articole practice despre detecția apei subterane și evaluarea terenului înainte de foraj.</p>
  </section>

  <section class="container post-list">
    {
      posts.map((post) => (
        <article class="card post-card">
          {post.data.image && (
            <a href={`/blog/${post.id}/`}>
              <img
                class="post-card-cover"
                src={post.data.image}
                alt=""
                width="1792"
                height="1024"
                loading="lazy"
              />
            </a>
          )}
          <h2>
            <a href={`/blog/${post.id}/`}>{post.data.title}</a>
          </h2>
          <p class="post-meta">
            {post.data.pubDate.toLocaleDateString('ro-RO', { year: 'numeric', month: 'long', day: 'numeric' })}
          </p>
          <p>{post.data.description}</p>
          <a href={`/blog/${post.id}/`}>Citește articolul →</a>
        </article>
      ))
    }
  </section>
</BaseLayout>
