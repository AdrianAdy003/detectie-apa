---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localBusinessJsonLd } from '../lib/jsonld';
import {
  PHONE_DISPLAY,
  PHONE_E164,
  CONTACT_EMAIL,
  WHATSAPP_URL,
  SERVICE_AREAS,
  WEB3FORMS_ACCESS_KEY,
  SITE_URL,
} from '../config';

const title = 'Contact';
const description = 'Contactează-ne pentru o evaluare de detecție a apei subterane: telefon, e-mail sau WhatsApp.';
---

<BaseLayout title={title} description={description} path="/contact/" jsonLd={localBusinessJsonLd()}>
  <section class="page-header container">
    <h1>Contact</h1>
    <p>
      Cel mai rapid ne găsești pe WhatsApp. Îți răspundem cu detalii despre disponibilitate și
      costul unei evaluări.
    </p>
  </section>

  <section class="container card-grid">
    <div class="card">
      <h3>Telefon</h3>
      <p><a href={`tel:${PHONE_E164}`}>{PHONE_DISPLAY}</a></p>
    </div>
    <div class="card">
      <h3>WhatsApp</h3>
      <p>
        <a class="btn btn-whatsapp" href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer">
          Scrie-ne acum
        </a>
      </p>
    </div>
    <div class="card">
      <h3>E-mail</h3>
      <p><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>
    </div>
  </section>

  <section class="container prose">
    <h2>Zone deservite</h2>
    <p>{SERVICE_AREAS.join(', ')}.</p>
  </section>

  <section class="container">
    <h2>Sau lasă-ne datele tale</h2>
    <p>Completezi în 30 de secunde, te sunăm noi înapoi.</p>

    <form class="contact-form card" action="https://api.web3forms.com/submit" method="POST">
      <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
      <input type="hidden" name="subject" value="Cerere nouă de pe detectieapa.ro" />
      <input type="hidden" name="from_name" value="Formular Detecție Apă" />
      <input type="hidden" name="redirect" value={new URL('/contact/multumim/', SITE_URL).toString()} />
      <input type="checkbox" name="botcheck" class="botcheck" tabindex="-1" autocomplete="off" />

      <div class="form-field">
        <label for="name">Nume și prenume</label>
        <input type="text" id="name" name="name" required />
      </div>

      <div class="form-field">
        <label for="phone">Telefon</label>
        <input type="tel" id="phone" name="phone" required />
      </div>

      <div class="form-field">
        <label for="county">Județ</label>
        <input type="text" id="county" name="county" required />
      </div>

      <div class="form-field">
        <label for="locality">Localitate</label>
        <input type="text" id="locality" name="locality" required />
      </div>

      <div class="form-field form-field-full">
        <label for="message">Mesaj (opțional)</label>
        <textarea id="message" name="message" rows="3"></textarea>
      </div>

      <button type="submit" class="btn btn-primary">Trimite cererea</button>
    </form>
  </section>
</BaseLayout>
