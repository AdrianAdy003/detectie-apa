---
import { WHATSAPP_URL } from '../config';
---

<a
  class="whatsapp-floating"
  href={WHATSAPP_URL}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Contactează-ne pe WhatsApp"
  title="Contactează-ne pe WhatsApp"
>
  <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true" focusable="false">
    <path
      fill="currentColor"
      d="M16.02 3C9.4 3 4 8.36 4 14.96c0 2.2.6 4.27 1.65 6.05L4 29l8.2-2.35a12.9 12.9 0 0 0 3.82.58h.01c6.62 0 12.02-5.36 12.02-11.96C28.05 8.36 22.65 3 16.02 3Zm0 21.9h-.01a10 10 0 0 1-5.1-1.4l-.37-.22-4.86 1.4 1.3-4.73-.24-.39a9.86 9.86 0 0 1-1.53-5.3c0-5.47 4.47-9.92 9.82-9.92 2.62 0 5.08 1.02 6.94 2.87a9.78 9.78 0 0 1 2.87 6.95c0 5.47-4.47 9.92-9.82 9.92Zm5.4-7.42c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.66.15-.2.3-.76.96-.93 1.16-.17.2-.34.22-.64.07-.3-.15-1.24-.46-2.37-1.47-.87-.78-1.46-1.74-1.63-2.04-.17-.3-.02-.46.13-.6.13-.13.3-.34.44-.51.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.66-1.6-.9-2.19-.24-.58-.48-.5-.66-.5h-.56c-.2 0-.52.07-.79.37-.27.3-1.03 1.01-1.03 2.46s1.06 2.86 1.2 3.06c.15.2 2.09 3.2 5.08 4.48.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.75-.72 2-1.41.24-.7.24-1.3.17-1.42-.07-.13-.27-.2-.56-.35Z"
    ></path>
  </svg>
</a>

<style>
  .whatsapp-floating {
    position: fixed;
    right: 1.1rem;
    bottom: 1.1rem;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--color-whatsapp);
    color: #fff;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
    transition: transform 0.15s ease;
  }

  .whatsapp-floating:hover,
  .whatsapp-floating:focus-visible {
    transform: scale(1.06);
  }

  @media (max-width: 799px) {
    .whatsapp-floating {
      display: none;
    }
  }
</style>
