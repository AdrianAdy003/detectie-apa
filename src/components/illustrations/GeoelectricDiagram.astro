---
// Ilustrație originală: principiul metodei geoelectrice (electrozi, curent electric,
// zonă cu rezistivitate scăzută = apă). Fără referire la niciun echipament anume.
---

<svg
  class="geoelectric-diagram"
  viewBox="0 0 640 340"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-labelledby="geoelectric-diagram-title"
>
  <title id="geoelectric-diagram-title">
    Schema principiului geoelectric: electrozi la suprafață, curent electric și zonă cu apă
  </title>

  <!-- cer -->
  <rect x="0" y="0" width="640" height="90" fill="#eaf6f3" />
  <!-- sol -->
  <rect x="0" y="90" width="640" height="250" fill="#d8c79a" />
  <rect x="0" y="200" width="640" height="140" fill="#c2ae7c" opacity="0.6" />

  <!-- linia solului -->
  <line x1="0" y1="90" x2="640" y2="90" stroke="#8a6d4b" stroke-width="3" />

  <!-- zona cu apa (rezistivitate scazuta) -->
  <ellipse cx="320" cy="255" rx="150" ry="55" fill="#0f7a8c" opacity="0.55" />
  <ellipse cx="320" cy="255" rx="150" ry="55" fill="none" stroke="#0b4f5c" stroke-width="2" stroke-dasharray="5 5" />

  <!-- electrozi (tije infipte in sol) -->
  {[110, 250, 390, 530].map((x) => (
    <g>
      <line x1={x} y1="38" x2={x} y2="88" stroke="#0b4f5c" stroke-width="4" />
      <path d={`M${x - 6} 86 L${x} 98 L${x + 6} 86 Z`} fill="#0b4f5c" />
    </g>
  ))}

  <!-- curent electric: arce intre electrozi -->
  <path d="M110 90 C 160 150 480 150 530 90" fill="none" stroke="#1fae7a" stroke-width="3" stroke-dasharray="8 6" />
  <path d="M250 90 C 275 120 365 120 390 90" fill="none" stroke="#1fae7a" stroke-width="3" stroke-dasharray="8 6" />

  <!-- etichete -->
  <g font-family="system-ui, sans-serif" font-size="15" font-weight="600" fill="#0b4f5c">
    <text x="320" y="26" text-anchor="middle">Electrozi la suprafață</text>
  </g>

  <g font-family="system-ui, sans-serif" font-size="15" font-weight="600" fill="#155f3d">
    <text x="70" y="140" text-anchor="start">Curent electric</text>
  </g>

  <g font-family="system-ui, sans-serif" font-size="15" font-weight="700" fill="#eaf6f3">
    <text x="320" y="260" text-anchor="middle">Zonă cu apă</text>
    <text x="320" y="280" text-anchor="middle" font-size="13" font-weight="600">(rezistivitate scăzută)</text>
  </g>
</svg>

<style>
  .geoelectric-diagram {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    display: block;
  }
</style>
