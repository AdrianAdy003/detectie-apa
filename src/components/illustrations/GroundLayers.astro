---
// Ilustrație originală: secțiune de sol până la stratul acvifer. Fără nicio legătură cu un
// produs sau furnizor anume — desenată de la zero pentru acest site.
---

<svg
  class="ground-layers"
  viewBox="0 0 640 380"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-labelledby="ground-layers-title"
>
  <title id="ground-layers-title">Secțiune de sol, de la suprafață până la stratul de apă subterană</title>

  <!-- cer -->
  <rect x="0" y="0" width="640" height="46" fill="#eaf6f3" />

  <!-- iarbă / suprafață -->
  <rect x="0" y="46" width="640" height="26" fill="#4fa66b" />
  <path
    d="M0 46 Q 20 38 40 46 T 80 46 T 120 46 T 160 46 T 200 46 T 240 46 T 280 46 T 320 46 T 360 46 T 400 46 T 440 46 T 480 46 T 520 46 T 560 46 T 600 46 T 640 46"
    fill="none"
    stroke="#3d8a56"
    stroke-width="3"
  />

  <!-- straturi de sol -->
  <rect x="0" y="72" width="640" height="58" fill="#8a6d4b" />
  <rect x="0" y="130" width="640" height="66" fill="#cdb26b" />
  <rect x="0" y="196" width="640" height="62" fill="#6b4f3a" />
  <rect x="0" y="258" width="640" height="122" fill="#8a8a8a" />

  <!-- pungă de apă subterană, suprapusă peste stratul de nisip/pietriș -->
  <path
    d="M120 150 C 160 132 220 132 260 150 C 320 172 400 172 460 150 C 500 136 520 150 520 168
       C 520 196 480 206 400 206 C 320 206 280 196 220 206 C 160 216 120 200 120 178 Z"
    fill="#0f7a8c"
    opacity="0.75"
  />

  <!-- linie punct de foraj recomandat -->
  <line x1="300" y1="20" x2="300" y2="168" stroke="#0b4f5c" stroke-width="3" stroke-dasharray="6 6" />
  <circle cx="300" cy="14" r="9" fill="#0b4f5c" />
  <path
    d="M300 172 c 10 -12 10 -22 0 -30 c -10 8 -10 18 0 30 Z"
    fill="#eaf6f3"
  />

  <!-- etichete -->
  <g font-family="system-ui, sans-serif" font-size="16" fill="#1c2a2e">
    <text x="16" y="106" font-weight="600" fill="#fff">Sol</text>
    <text x="16" y="168" font-weight="600" fill="#3a2f10">Nisip și pietriș</text>
    <text x="16" y="232" font-weight="600" fill="#fff">Argilă</text>
    <text x="16" y="322" font-weight="600" fill="#fff">Rocă impermeabilă</text>
  </g>

  <g font-family="system-ui, sans-serif" font-size="16" font-weight="700" fill="#eaf6f3">
    <text x="330" y="182" text-anchor="start">Apă subterană</text>
  </g>

  <g font-family="system-ui, sans-serif" font-size="14" font-weight="600" fill="#0b4f5c">
    <text x="234" y="34" text-anchor="middle">Punct recomandat</text>
  </g>
</svg>

<style>
  .ground-layers {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    display: block;
  }
</style>
